# Personal deployment configuration for dustytrails
# Copy to deploy.config and customize for your environment.
# NOTE: put real secrets in deploy.secrets (gitignored), NOT here — this file is
# also read by the app as a local-dev fallback. See deploy.secrets.example.

PI_HOST="raspi.local"   # an mDNS name (e.g. host.local) survives DHCP changes
PI_USER="pi"

# Keep these EMPTY for local dev (empty PurpleAir key = no API quota burned).
# deploy_to_pi.sh sources deploy.secrets after this file to inject the real keys.
DUSTY_PURPLEAIR_API_KEY=""
AIRNOW_API_KEY=""

# If empty or commented out, deploy will auto-generate one.
DUSTY_OWNER_TOKEN=""

# Database archival & backup
# DUSTY_DB_RETENTION_DAYS="30"       # Keep hot data for 30 days (default)
# DUSTY_DB_MAX_SIZE_MB="1024"        # Emergency prune if DB exceeds 1 GB
# DUSTY_BACKUP_TARGET="user@mac.local:/backups/dustytrails/"  # rsync destination
