# Copy to deploy.secrets and fill in. deploy.secrets is GITIGNORED and is
# sourced by deploy_to_pi.sh AFTER deploy.config (so it overrides those values).
#
# Keep REAL secrets here — NOT in deploy.config. deploy.config is also read by
# the app as a local-dev fallback and should stay empty so local runs don't
# burn PurpleAir API quota. At deploy time these values are injected into the
# Pi's systemd Environment (/etc/systemd/system/dustytrails.service.d/secrets.conf).

DUSTY_PURPLEAIR_API_KEY=""
# AIRNOW_API_KEY=""
# DUSTY_OWNER_TOKEN=""   # optional; if unset, deploy preserves/auto-generates one
